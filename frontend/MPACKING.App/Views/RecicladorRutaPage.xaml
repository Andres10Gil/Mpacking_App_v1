<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MPACKING.App.ViewModels"
             xmlns:comp="clr-namespace:MPACKING.App.Views.Componentes"
             x:Class="MPACKING.App.Views.RecicladorRutaPage"
             x:DataType="vm:RecicladorRutaViewModel"
             BackgroundColor="{StaticResource MpFondoPagina}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="22,36,22,30" Spacing="0">

                <Label FontSize="14" TextColor="{StaticResource MpVerdeEtiqueta}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Hola, " />
                            <Span Text="{Binding Nombre}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label Text="{Binding Zona}"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{StaticResource MpVerdeTitulo}"
                       Margin="0,0,0,18" />

                <!-- Estado de ruta -->
                <Border BackgroundColor="{StaticResource MpVerdeBoton}"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 26"
                        Padding="24,22">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Estas en ruta" FontSize="12" TextColor="White" />
                        <Label FontSize="22" FontAttributes="Bold" TextColor="White">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding EnRuta}" Value="True">
                                    <Setter Property="Text" Value="GPS activo" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding EnRuta}" Value="False">
                                    <Setter Property="Text" Value="GPS apagado" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>
                </Border>

                <Button Text="Reportar mi ubicacion"
                        Command="{Binding ReportarUbicacionCommand}"
                        BackgroundColor="{StaticResource MpFondoCampo}"
                        TextColor="{StaticResource MpVerdeTitulo}"
                        FontAttributes="Bold"
                        CornerRadius="22"
                        HeightRequest="48"
                        Margin="0,12,0,0" />

                <!-- Stats -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,16,0,0">
                    <Border Grid.Column="0" BackgroundColor="{StaticResource MpFondoCampo}"
                            Stroke="Transparent" StrokeShape="RoundRectangle 20" HeightRequest="84">
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                            <Label Text="{Binding KgHoyTexto}" FontSize="20" FontAttributes="Bold"
                                   TextColor="{StaticResource MpVerdeTitulo}" HorizontalOptions="Center" />
                            <Label Text="recolectado hoy" FontSize="10"
                                   TextColor="{StaticResource MpVerdeEtiqueta}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="{StaticResource MpAmarillo}"
                            Stroke="Transparent" StrokeShape="RoundRectangle 20" HeightRequest="84">
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                            <Label Text="{Binding KgMesTexto}" FontSize="20" FontAttributes="Bold"
                                   TextColor="{StaticResource MpVerdeTitulo}" HorizontalOptions="Center" />
                            <Label Text="recolectado este mes" FontSize="10"
                                   TextColor="{StaticResource MpVerdeEtiqueta}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Button Text="Confirmar recoleccion"
                        Command="{Binding IrAConfirmarCommand}"
                        BackgroundColor="{StaticResource MpVerdeBoton}"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="26"
                        HeightRequest="54"
                        Margin="0,20,0,0" />

                <Label Text="{Binding MensajeError}"
                       TextColor="{StaticResource MpError}"
                       FontSize="12"
                       Margin="0,12,0,0" />

                <ActivityIndicator IsRunning="{Binding EstaOcupado}"
                                   IsVisible="{Binding EstaOcupado}"
                                   Color="{StaticResource MpVerdeBoton}"
                                   Margin="0,12,0,0" />

            </VerticalStackLayout>
        </ScrollView>

        <comp:BarraInferiorReciclador Grid.Row="1"
                                       TabActiva="Ruta"
                                       ComandoRuta="{Binding CargarCommand}"
                                       ComandoConfirmar="{Binding IrAConfirmarCommand}"
                                       ComandoHistorial="{Binding IrAHistorialCommand}"
                                       ComandoPerfil="{Binding IrAPerfilCommand}" />

    </Grid>
</ContentPage>
