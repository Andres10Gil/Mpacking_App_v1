<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MPACKING.App.ViewModels"
             xmlns:comp="clr-namespace:MPACKING.App.Views.Componentes"
             x:Class="MPACKING.App.Views.EcopesosGanadosPage"
             x:DataType="vm:EcopesosGanadosViewModel"
             BackgroundColor="{StaticResource MpFondoPagina}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <Grid>

                <Ellipse Fill="{StaticResource MpFondoCampoBrush}"
                         WidthRequest="510" HeightRequest="400"
                         HorizontalOptions="Center"
                         VerticalOptions="Start"
                         TranslationY="-240" />

                <Ellipse Fill="{StaticResource MpAmarilloBrush}" WidthRequest="14" HeightRequest="14"
                         HorizontalOptions="Start" VerticalOptions="Start" Margin="50,110,0,0" />
                <Ellipse Fill="{StaticResource MpAzulBrush}" WidthRequest="10" HeightRequest="10"
                         HorizontalOptions="Start" VerticalOptions="Start" Margin="80,190,0,0" />
                <Ellipse Fill="{StaticResource MpDuraznoBrush}" WidthRequest="12" HeightRequest="12"
                         HorizontalOptions="End" VerticalOptions="Start" Margin="0,130,60,0" />
                <Ellipse Fill="{StaticResource MpRosadoBrush}" WidthRequest="12" HeightRequest="12"
                         HorizontalOptions="End" VerticalOptions="Start" Margin="0,210,40,0" />

                <VerticalStackLayout Padding="24,60,24,30" Spacing="0">

                    <Label Text="Muy bien!"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="{StaticResource MpVerdeTitulo}"
                           HorizontalOptions="Center"
                           Margin="0,0,0,20" />

                    <Border BackgroundColor="White"
                            Stroke="{StaticResource MpVerdeAcentoBrush}"
                            StrokeThickness="6"
                            StrokeShape="RoundRectangle 96"
                            WidthRequest="192" HeightRequest="192"
                            HorizontalOptions="Center">
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="0">
                            <Label Text="ganaste" FontSize="14" TextColor="{StaticResource MpTextoPlaceholder}"
                                   HorizontalOptions="Center" />
                            <Label Text="{Binding Ecopesos, StringFormat='+{0}'}" FontSize="60" FontAttributes="Bold"
                                   TextColor="{StaticResource MpVerdeEtiqueta}" HorizontalOptions="Center" />
                            <Label Text="ecopesos" FontSize="16" FontAttributes="Bold"
                                   TextColor="{StaticResource MpVerdeAcento}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="White"
                            Stroke="{StaticResource MpBordeTarjetaBrush}"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 22"
                            Margin="0,30,0,0">
                        <VerticalStackLayout Padding="20,16" Spacing="0">
                            <Label Text="Detalle" FontSize="15" FontAttributes="Bold"
                                   TextColor="{StaticResource MpVerdeTitulo}" Margin="0,0,0,10" />

                            <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                                <Label Grid.Column="0" Text="Material" FontSize="12"
                                       TextColor="{StaticResource MpTextoPlaceholder}" />
                                <Label Grid.Column="1" Text="{Binding Material}" FontSize="13" FontAttributes="Bold"
                                       TextColor="{StaticResource MpTextoOscuro}" />
                            </Grid>
                            <BoxView HeightRequest="1.5" Color="{StaticResource MpDivisor}" />

                            <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                                <Label Grid.Column="0" Text="Peso" FontSize="12"
                                       TextColor="{StaticResource MpTextoPlaceholder}" />
                                <Label Grid.Column="1" Text="{Binding PesoTexto, StringFormat='{0} kg'}" FontSize="13" FontAttributes="Bold"
                                       TextColor="{StaticResource MpTextoOscuro}" />
                            </Grid>
                            <BoxView HeightRequest="1.5" Color="{StaticResource MpDivisor}" />

                            <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                                <Label Grid.Column="0" Text="CO2 evitado" FontSize="12"
                                       TextColor="{StaticResource MpTextoPlaceholder}" />
                                <Label Grid.Column="1" Text="{Binding Co2Texto, StringFormat='{0} kg'}" FontSize="13" FontAttributes="Bold"
                                       TextColor="{StaticResource MpTextoOscuro}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Button Text="Ver mi billetera"
                            Command="{Binding IrABilleteraCommand}"
                            BackgroundColor="{StaticResource MpVerdeBoton}"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="16"
                            CornerRadius="27"
                            HeightRequest="54"
                            Margin="0,20,0,0" />

                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <comp:BarraInferior Grid.Row="1" TabActiva="Inicio" ComandoInicio="{Binding IrAInicioCommand}" />

    </Grid>
</ContentPage>
