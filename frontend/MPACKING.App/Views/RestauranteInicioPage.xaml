<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MPACKING.App.ViewModels"
             xmlns:comp="clr-namespace:MPACKING.App.Views.Componentes"
             x:Class="MPACKING.App.Views.RestauranteInicioPage"
             x:DataType="vm:RestauranteInicioViewModel"
             BackgroundColor="{StaticResource MpFondoPagina}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="22,36,22,30" Spacing="0">

                <Label Text="{Binding NombreRestaurante}"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{StaticResource MpVerdeTitulo}" />
                <Label Text="{Binding Direccion}"
                       FontSize="12"
                       TextColor="{StaticResource MpVerdeEtiqueta}"
                       Margin="0,4,0,18" />

                <!-- Recibido hoy -->
                <Border BackgroundColor="{StaticResource MpVerdeBoton}"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 26"
                        Padding="24,22">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                        <Label Text="Recibido hoy" TextColor="White" FontAttributes="Bold"
                               FontSize="12" HorizontalOptions="Center" />
                        <Label Text="{Binding RecibidoHoyTexto}" TextColor="White" FontAttributes="Bold"
                               FontSize="38" HorizontalOptions="Center" />
                        <Label FontSize="12" TextColor="White" HorizontalOptions="Center" Margin="0,4,0,0">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding RedencionesHoyTexto}" />
                                    <Span Text=" redenciones" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                </Border>

                <!-- Stats -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,16,0,0">
                    <Border Grid.Column="0" BackgroundColor="{StaticResource MpFondoCampo}"
                            Stroke="Transparent" StrokeShape="RoundRectangle 20" HeightRequest="84">
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                            <Label Text="{Binding RedencionesHoyTexto}" FontSize="20" FontAttributes="Bold"
                                   TextColor="{StaticResource MpVerdeTitulo}" HorizontalOptions="Center" />
                            <Label Text="redenciones hoy" FontSize="10"
                                   TextColor="{StaticResource MpVerdeEtiqueta}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="{StaticResource MpAmarillo}"
                            Stroke="Transparent" StrokeShape="RoundRectangle 20" HeightRequest="84">
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                            <Label Text="{Binding EcopesosValidadosTexto}" FontSize="20" FontAttributes="Bold"
                                   TextColor="{StaticResource MpVerdeTitulo}" HorizontalOptions="Center" />
                            <Label Text="ecopesos validados" FontSize="10"
                                   TextColor="{StaticResource MpVerdeEtiqueta}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Ultimas redenciones -->
                <Border BackgroundColor="White"
                        Stroke="{StaticResource MpBordeTarjetaBrush}"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 22"
                        Margin="0,16,0,0">
                    <VerticalStackLayout Padding="20,16" Spacing="4">
                        <Label Text="Ultimas redenciones" FontSize="15" FontAttributes="Bold"
                               TextColor="{StaticResource MpVerdeTitulo}" Margin="0,0,0,8" />

                        <CollectionView ItemsSource="{Binding Ultimas}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:RedencionRecienteVm">
                                    <Grid Padding="0,8" ColumnDefinitions="34,*,Auto" ColumnSpacing="10">
                                        <Ellipse Grid.Column="0" Fill="{Binding BadgeColor}"
                                                 WidthRequest="30" HeightRequest="30" VerticalOptions="Start" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding Usuario}" FontSize="12" FontAttributes="Bold"
                                                   TextColor="{StaticResource MpTextoOscuro}" />
                                            <Label Text="{Binding Detalle}" FontSize="10"
                                                   TextColor="{StaticResource MpTextoPlaceholder}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding MontoTexto}" FontSize="12"
                                               FontAttributes="Bold" TextColor="{StaticResource MpVerdeEtiqueta}"
                                               VerticalOptions="Start" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <Button Text="Validar redencion"
                        Command="{Binding ValidarRedencionCommand}"
                        BackgroundColor="{StaticResource MpVerdeBoton}"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="26"
                        HeightRequest="54"
                        Margin="0,16,0,0" />

                <Label Text="{Binding MensajeError}"
                       TextColor="{StaticResource MpError}"
                       FontSize="12"
                       Margin="0,12,0,0" />

                <ActivityIndicator IsRunning="{Binding EstaOcupado}"
                                   IsVisible="{Binding EstaOcupado}"
                                   Color="{StaticResource MpVerdeBoton}"
                                   Margin="0,12,0,0" />

            </VerticalStackLayout>
        </ScrollView>

        <comp:BarraInferiorRestaurante Grid.Row="1"
                                        TabActiva="Inicio"
                                        ComandoInicio="{Binding CargarCommand}"
                                        ComandoBeneficios="{Binding IrABeneficiosCommand}"
                                        ComandoHistorial="{Binding IrAHistorialCommand}"
                                        ComandoPerfil="{Binding IrAPerfilCommand}" />

    </Grid>
</ContentPage>
