<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MPACKING.App.ViewModels"
             xmlns:comp="clr-namespace:MPACKING.App.Views.Componentes"
             x:Class="MPACKING.App.Views.RestauranteBeneficiosPage"
             x:DataType="vm:RestauranteBeneficiosViewModel"
             BackgroundColor="{StaticResource MpFondoPagina}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="22,36,22,30" Spacing="0">

                <Label Text="Mis beneficios"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{StaticResource MpVerdeTitulo}" />
                <Label Text="Lo que pueden canjear"
                       FontSize="13"
                       TextColor="{StaticResource MpVerdeEtiqueta}"
                       Margin="0,4,0,18" />

                <Button Text="Anadir beneficio"
                        Command="{Binding AnadirBeneficioCommand}"
                        BackgroundColor="{StaticResource MpVerdeBoton}"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="24"
                        HeightRequest="50"
                        Margin="0,0,0,16" />

                <CollectionView ItemsSource="{Binding Beneficios}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:BeneficioRestauranteVm">
                            <Border BackgroundColor="White"
                                    Stroke="{StaticResource MpBordeTarjetaBrush}"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 22"
                                    Margin="0,0,0,12">
                                <Grid Padding="20,16" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding Descripcion}" FontSize="15"
                                           FontAttributes="Bold" TextColor="{StaticResource MpVerdeTitulo}" />
                                    <Label Grid.Row="1" Grid.Column="0" Text="{Binding CostoTexto}" FontSize="11"
                                           TextColor="{StaticResource MpTextoPlaceholder}" Margin="0,6,0,0" />

                                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                            BackgroundColor="{StaticResource MpFondoCampo}"
                                            Stroke="Transparent" StrokeShape="RoundRectangle 14"
                                            Padding="14,8" VerticalOptions="Center">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RestauranteBeneficiosViewModel}}, Path=CambiarEstadoCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding EstadoTexto}" FontSize="11" FontAttributes="Bold"
                                               TextColor="{StaticResource MpVerdeEtiqueta}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="{Binding MensajeError}"
                       TextColor="{StaticResource MpError}"
                       FontSize="12"
                       Margin="0,12,0,0" />

                <ActivityIndicator IsRunning="{Binding EstaOcupado}"
                                   IsVisible="{Binding EstaOcupado}"
                                   Color="{StaticResource MpVerdeBoton}"
                                   Margin="0,12,0,0" />

            </VerticalStackLayout>
        </ScrollView>

        <comp:BarraInferiorRestaurante Grid.Row="1"
                                        TabActiva="Beneficios"
                                        ComandoInicio="{Binding VolverCommand}"
                                        ComandoBeneficios="{Binding CargarCommand}"
                                        ComandoHistorial="{Binding IrAHistorialCommand}"
                                        ComandoPerfil="{Binding IrAPerfilCommand}" />

    </Grid>
</ContentPage>
