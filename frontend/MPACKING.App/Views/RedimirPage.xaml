<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MPACKING.App.ViewModels"
             xmlns:comp="clr-namespace:MPACKING.App.Views.Componentes"
             x:Class="MPACKING.App.Views.RedimirPage"
             x:DataType="vm:RedimirViewModel"
             BackgroundColor="{StaticResource MpFondoPagina}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <Grid>

                <Border BackgroundColor="{StaticResource MpFondoCampo}"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 0,0,26,26"
                        HeightRequest="132"
                        VerticalOptions="Start"
                        HorizontalOptions="Fill" />

                <VerticalStackLayout Padding="22,36,22,30" Spacing="0">

                    <Label Text="Redimir"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="{StaticResource MpVerdeTitulo}"
                           Margin="0,0,0,18" />

                    <Border BackgroundColor="{StaticResource MpVerdeBoton}"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 24"
                            Padding="24,16">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Tu saldo" TextColor="White" FontSize="12" />
                            <Label TextColor="White" FontSize="24" FontAttributes="Bold">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding SaldoTexto}" />
                                        <Span Text=" ecopesos" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="White"
                            Stroke="{StaticResource MpBordeTarjetaBrush}"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 22"
                            Margin="0,16,0,0">
                        <VerticalStackLayout Padding="20,16" Spacing="4">

                            <Label Text="{Binding NombreRestaurante}" FontSize="17" FontAttributes="Bold"
                                   TextColor="{StaticResource MpVerdeTitulo}" />
                            <Label Text="{Binding DireccionRestaurante}" FontSize="11"
                                   TextColor="{StaticResource MpTextoPlaceholder}" Margin="0,0,0,6" />
                            <BoxView HeightRequest="1.5" Color="{StaticResource MpDivisor}" Margin="0,0,0,4" />

                            <CollectionView ItemsSource="{Binding Beneficios}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BeneficioVm">
                                        <Grid Padding="0,12" ColumnDefinitions="*,Auto">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RedimirViewModel}}, Path=SeleccionarCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <Label Grid.Column="0" Text="{Binding Descripcion}" FontSize="13"
                                                   FontAttributes="Bold" TextColor="{StaticResource MpTextoOscuro}"
                                                   VerticalOptions="Center" LineBreakMode="WordWrap" />
                                            <Border Grid.Column="1"
                                                    BackgroundColor="{StaticResource MpFondoCampo}"
                                                    Stroke="Transparent" StrokeShape="RoundRectangle 15"
                                                    Padding="14,6" VerticalOptions="Center">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding EstaSeleccionado}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource MpVerdeBoton}" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Label Text="{Binding EcopesosTexto}" FontSize="11" FontAttributes="Bold"
                                                       TextColor="{StaticResource MpVerdeEtiqueta}">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label"
                                                                     Binding="{Binding EstaSeleccionado}" Value="True">
                                                            <Setter Property="TextColor" Value="White" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="{StaticResource MpFondoCampo}"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 22"
                            Margin="0,16,0,0"
                            IsVisible="{Binding HaySeleccion}">
                        <VerticalStackLayout Padding="20,14" Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Usaras" FontSize="12"
                                       TextColor="{StaticResource MpVerdeEtiqueta}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding ResumenEcopesosTexto}" FontSize="14"
                                       FontAttributes="Bold" TextColor="{StaticResource MpError}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Equivale a" FontSize="12"
                                       TextColor="{StaticResource MpVerdeEtiqueta}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding ResumenCopTexto}" FontSize="14"
                                       FontAttributes="Bold" TextColor="{StaticResource MpVerdeEtiqueta}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="{Binding MensajeError}"
                           TextColor="{StaticResource MpError}"
                           FontSize="12"
                           Margin="0,12,0,0" />

                    <ActivityIndicator IsRunning="{Binding EstaOcupado}"
                                       IsVisible="{Binding EstaOcupado}"
                                       Color="{StaticResource MpVerdeBoton}"
                                       Margin="0,12,0,0" />

                    <Button Text="Confirmar canje"
                            Command="{Binding ConfirmarCanjeCommand}"
                            IsVisible="{Binding HaySeleccion}"
                            BackgroundColor="{StaticResource MpVerdeBoton}"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="16"
                            CornerRadius="27"
                            HeightRequest="54"
                            Margin="0,16,0,0" />

                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <comp:BarraInferior Grid.Row="1"
                             TabActiva="Billetera"
                             ComandoInicio="{Binding VolverCommand}" />

    </Grid>
</ContentPage>
